{
  "manifest_version": 3,
  "name": "QuickBind",
  "version": "0.2.0",
  "description": "Quickly open saved URLs via global hotkeys. Built-in ad blocker. All data stored locally.",
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Open QuickBind popup"
    },
    "open_active_link": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      },
      "description": "Opens the active saved link in a new tab"
    }
  }
}